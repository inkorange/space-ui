{
  "name": "@inkorange/space-ui",
  "version": "1.7.1",
  "description": "SpaceUI \u2014 a space-themed React component library and design system",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://space-components.vercel.app",
  "bugs": {
    "url": "https://github.com/inkorange/space-ui/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "component-library",
    "dark-theme",
    "design-tokens",
    "react-19"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/inkorange/space-ui"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/space-ui.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly && cp src/styles/tokens.css dist/tokens.css",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc --noEmit",
    "check:exports": "node scripts/check-exports.mjs",
    "test:coverage": "vitest run --coverage",
    "badges:write": "node scripts/badges.mjs --write",
    "badges:check": "node scripts/badges.mjs --check"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/browser": "^5.0.1",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "react": "^19",
    "react-dom": "^19",
    "sass": "^1.89.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.1",
    "vitest-browser-react": "^2.3.0"
  }
}
