{
  "name": "@inkorange/space-ui",
  "version": "1.0.2",
  "description": "SpaceUI — a space-themed React component library and design system",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://space-components.vercel.app",
  "bugs": {
    "url": "https://github.com/inkorange/space-ui/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "component-library",
    "dark-theme",
    "design-tokens",
    "react-19"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/inkorange/space-ui"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/space-ui.css",
    "./tokens.css": "./dist/tokens.css",
    "./spaceControls": {
      "types": "./dist/styles/spaceControls.d.ts",
      "import": "./dist/spaceControls.js",
      "require": "./dist/spaceControls.cjs"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly && cp src/styles/tokens.css dist/tokens.css",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:exports": "node scripts/check-exports.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.6.0",
    "happy-dom": "^18.0.0",
    "react": "^19",
    "react-dom": "^19",
    "sass": "^1.89.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
