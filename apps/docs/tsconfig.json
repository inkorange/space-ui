{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    // Mirrors the aliases in vite.config.ts. Without these, tsc resolves the
    // library to its built dist while the gallery renders from source — the
    // checker and the running app disagree, which is how a story calling a
    // prop that no longer exists went unnoticed.
    "paths": {
      "@inkorange/space-ui": ["../../packages/space-ui/src/index.ts"],
      "@inkorange/space-ui/spaceControls": [
        "../../packages/space-ui/src/styles/spaceControls.ts"
      ]
    }
  },
  "include": ["src", ".ladle"]
}
