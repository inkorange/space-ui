    "components--layout--card": {
      "name": "Card",
      "levels": [
        "Components",
        "Layout"
      ],
      "locStart": 28,
      "locEnd": 48,
      "filePath": "src/layout.stories.tsx",
      "namedExport": "CardStory",
      "meta": {
        "description": "A translucent panel for grouping related content. Pass `image` for a media card: the card frames it full-bleed, matches its own corner radius, and reserves the box before the image loads so a row of cards never reflows as thumbnails arrive. The 12px inset is a deliberate exception to the spacing grid, kept for parity with the shipped app."
      }
    },
